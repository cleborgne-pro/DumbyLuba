<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later (allowBackup="false" covers the older versions): no cloud backup, as before. The device to
  device transfer stays as Android did it with allowBackup="false" (everything copied): the Mammotion session and the
  saved account are encrypted with a Keystore key that does not move, so the new phone cannot read them and clears them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
